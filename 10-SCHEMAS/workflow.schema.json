{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/VuDube/portable-agent-workbench/schema/workflow.json",
  "title": "PAW workflow",
  "type": "object",
  "required": [
    "id",
    "name",
    "version",
    "purpose",
    "capability_tier",
    "steps",
    "outputs",
    "exit_criteria"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "purpose": {
      "type": "string"
    },
    "capability_tier": {
      "enum": [
        "T0",
        "T1",
        "T2",
        "T3"
      ]
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "instruction"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "instruction": {
            "type": "string"
          },
          "approval_required": {
            "type": "boolean"
          }
        }
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "exit_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
